{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screen-with-me",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Site (apps/web'in derlenmiş hali) aynı Worker'dan statik dosya olarak sunulur.
  // /api/* istekleri önce Worker koduna gider; diğer her şey dosyalardan gelir,
  // bulunamayan yollar (örn. /r/abc123) index.html'e düşer.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // PlayWithMe oyun odaları (XOX…)
      { "name": "GAMES", "class_name": "Game" },
      // Çiz-Bil oyunları
      { "name": "DRAWS", "class_name": "Draw" },
      // Bilgi yarışmaları
      { "name": "QUIZZES", "class_name": "Quiz" }
    ]
  },
  // Ücretsiz planda Durable Object'ler SQLite tabanlı olmak zorunda.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Game"] },
    { "tag": "v3", "new_sqlite_classes": ["Draw"] },
    { "tag": "v4", "new_sqlite_classes": ["Quiz"] }
  ],
  // New connections per IP and minute (WebSocket upgrades; rooms and games). Generous: a class or family behind one
  // address joining at once must still fit, a script opening rooms in a loop must not.
  "ratelimits": [{ "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
