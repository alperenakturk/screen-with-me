{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screen-with-me",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // QUOTA1a: limits such as MSG_RATE or ROOM_IP_CONNECTIONS (apps/server/src/limits.ts) can be set as variables in the
  // dashboard (Workers → screen-with-me → Settings → Variables) to loosen one in an emergency; a deploy keeps them.
  "keep_vars": true,
  // Site (apps/web'in derlenmiş hali) aynı Worker'dan statik dosya olarak sunulur.
  // /api/* istekleri önce Worker koduna gider; diğer her şey dosyalardan gelir,
  // bulunamayan yollar (örn. /r/abc123) index.html'e düşer.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // PlayWithMe oyun odaları (XOX…)
      { "name": "GAMES", "class_name": "Game" },
      // Çiz-Bil oyunları
      { "name": "DRAWS", "class_name": "Draw" },
      // Bilgi yarışmaları
      { "name": "QUIZZES", "class_name": "Quiz" },
      // Life poker tables
      { "name": "POKERS", "class_name": "Poker" },
      // 🚢 Sea Battle tables (fleets hidden here)
      { "name": "FLEETS", "class_name": "Sea" },
      // ⚔️ Five Frames Duel tables (the answer and the guesses hidden here)
      { "name": "DUELS", "class_name": "Duel" },
      // TVs waiting to be paired (one per 6-digit code, nothing stored)
      { "name": "TVLINKS", "class_name": "TvLink" },
      // Feedback counters (card 9): one instance, a day's and an hour's counts, no texts
      { "name": "FEEDBACK", "class_name": "FeedbackGate" },
      // Two devices moving my things (one per 6-digit code, nothing stored)
      { "name": "MOVELINKS", "class_name": "MoveLink" },
      // YouTube usage counters for the quota form (card Y3): one instance, counts per day, no people data
      { "name": "USAGE", "class_name": "YoutubeUsage" },
      // The day's random key for the IP hash (security M5): one instance, today's key only
      { "name": "IPKEYS", "class_name": "IpKeys" },
      // Image upload budgets across all rooms (security R4-1): one instance, today's byte counts per IP hash only
      { "name": "UPLOADS", "class_name": "UploadGate" },
      // QUOTA2: open HTTP-fallback sessions per address across all rooms and tables: one small instance per IP hash
      { "name": "FBGATE", "class_name": "FallbackGate" }
    ]
  },
  // Ücretsiz planda Durable Object'ler SQLite tabanlı olmak zorunda.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Game"] },
    { "tag": "v3", "new_sqlite_classes": ["Draw"] },
    { "tag": "v4", "new_sqlite_classes": ["Quiz"] },
    { "tag": "v5", "new_sqlite_classes": ["TvLink"] },
    { "tag": "v6", "new_sqlite_classes": ["Poker"] },
    { "tag": "v7", "new_sqlite_classes": ["FeedbackGate"] },
    { "tag": "v8", "new_sqlite_classes": ["MoveLink"] },
    { "tag": "v9", "new_sqlite_classes": ["YoutubeUsage"] },
    { "tag": "v10", "new_sqlite_classes": ["IpKeys"] },
    { "tag": "v11", "new_sqlite_classes": ["UploadGate"] },
    { "tag": "v12", "new_sqlite_classes": ["Sea"] },
    { "tag": "v13", "new_sqlite_classes": ["FallbackGate"] },
    { "tag": "v14", "new_sqlite_classes": ["Duel"] }
  ],
  // New connections per IP and minute (WebSocket upgrades; rooms and games). Generous: a class or family behind one
  // address joining at once must still fit, a script opening rooms in a loop must not.
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // YouTube searches per IP and minute that reach YouTube (each costs 1 % of the free daily quota; cache hits are free).
    { "name": "SEARCH_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Saved-room lookups (`/api/rooms/:id/info` + `unsave`) per IP and minute: each wakes a room object. The home page
    // asks once per saved room (at most 20) + the "continue" line, so 60 leaves room for a few reloads (R3-1, M4).
    { "name": "ROOM_INFO_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Feedback bursts per IP and minute (card 9); the hourly / daily caps live in the FeedbackGate object.
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
    // HTTP fallback requests (send / poll / close) per IP and minute (security M4). A room polls about every 20 s and
    // sends one batch at a time (the next waits for the answer, so a fast network may send ~10 a second while drawing);
    // 1200 leaves room for a room plus a game in two tabs. A 429 only makes the client wait 1.5 s (socket.ts).
    { "name": "FALLBACK_LIMIT", "namespace_id": "1005", "simple": { "limit": 1200, "period": 60 } }
  ],
  // The deployed version's id (`/api/version`): after a deploy the live e2e waits until the Worker and a Durable Object
  // both answer with it, so no test room starts on the old code and gets restarted mid-test.
  // Card UPTIME2: the uptime check inside the Worker (src/uptime.ts), every 15 minutes; GitHub's cron is best-effort.
  "triggers": { "crons": ["*/15 * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
